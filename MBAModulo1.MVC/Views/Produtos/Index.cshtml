@model IEnumerable<MBAModulo1.Core.Models.Produto>

@{
    ViewData["Title"] = "Lista de Produtos";
    Layout = "_Layout";
}

<h2>@ViewData["Title"]</h2>

<a asp-action="Create" class="btn btn-success mb-3">Novo Produto</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Preço</th>
            <th>Categoria</th>
            <th>Ações</th> 
        </tr>
    </thead>
    <tbody>
        @foreach (var produto in Model)
        {
            <tr>
                <td>@produto.Nome</td>
                <td>@produto.Preco.ToString("C")</td>
                <td>@produto.Categoria?.Nome</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@produto.Id" class="btn btn-sm btn-primary">Alterar</a>
                    <a asp-action="Delete" asp-route-id="@produto.Id" class="btn btn-sm btn-danger" onclick="return confirm('Tem certeza que deseja excluir este produto?');">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.16/jquery.mask.min.js"></script>
