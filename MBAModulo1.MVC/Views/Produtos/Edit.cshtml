@{
    Layout = "_Layout";
}
@model MBAModulo1.Core.Models.Produto

<h1>@ViewData["Title"]</h1>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h1 class="mb-4">Editar Produto</h1>

            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                
                <!-- Campo Nome -->
                <div class="form-group">
                    <label asp-for="Nome" class="control-label"></label>
                    <input asp-for="Nome" class="form-control" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>

                <!-- Campo Preço -->
                <div class="form-group">
                    <label asp-for="Preco" class="control-label"></label>
                    <input type="number" step="0.01" asp-for="Preco" class="form-control" />
                    <span asp-validation-for="Preco" class="text-danger"></span>
                </div>

                <!-- Campo Categoria -->
                <div class="form-group">
                    <label asp-for="CategoriaId" class="control-label">Categoria</label>
                    <select asp-for="CategoriaId" class="form-control" asp-items="ViewBag.Categorias">
                        <option value="">Selecione uma categoria</option>
                    </select>
                    <span asp-validation-for="CategoriaId" class="text-danger"></span>
                </div>

                <!-- Exibir Imagem Atual -->
                <div class="form-group">
                    <label class="control-label">Imagem Atual</label>
                    @if (!string.IsNullOrEmpty(Model.Imagem))
                    {
                        <div>
                            <img src="@Model.Imagem" alt="Imagem do Produto" style="max-width: 200px; height: auto;" />
                        </div>
                    }
                    <span>Se desejar, altere a imagem abaixo.</span>
                </div>

                <!-- Campo de Upload da Imagem -->
                <div class="form-group">
                    <label asp-for="Imagem" class="control-label">Nova Imagem</label>
                    <input type="file" name="imagem" class="form-control" />
                </div>

                <!-- Botões de ação -->
                <button type="submit" class="btn btn-primary">Salvar</button>
                <a href="@Url.Action("Index", "Produtos")" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial");
}
