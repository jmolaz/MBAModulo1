@{
    Layout = "_Layout";
}

<script>
    $(document).ready(function () {
        $('#Preco').on('input', function () {
            var valor = $(this).val();
            // Permite apenas números, ponto e vírgula
            $(this).val(valor.replace(/[^0-9,]/g, '').replace(/(\..*?)\./g, '$1')); // Remove letras e múltiplos pontos
        });

        // Ao submeter, substitui a vírgula por ponto (para garantir que o servidor entenda como número)
        $('form').submit(function () {
            var preco = $('#Preco').val();
            // Substitui a vírgula por ponto para ser aceito como número decimal
            $('#Preco').val(preco.replace(',', '.'));
        });
    });
</script>

@model MBAModulo1.Core.Models.Produto

<h1>@ViewData["Title"]</h1>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h1 class="mb-4">Novo Produto</h1>

            <form asp-action="Create" method="post">
                <div class="form-group">
                    <label asp-for="Nome" class="control-label"></label>
                    <input asp-for="Nome" class="form-control" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Preco" class="control-label"></label>
                    <input id="Preco" name="Preco" asp-for="Preco" class="form-control" />
                    <span asp-validation-for="Preco" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="CategoriaId" class="control-label">Categoria</label>
                    <select asp-for="CategoriaId" class="form-control" asp-items="ViewBag.Categorias">
                        <option value="">Selecione uma categoria</option>
                    </select>
                    <span asp-validation-for="CategoriaId" class="text-danger"></span>
                </div>

                <div class="form-group mt-3">
                    <button type="submit" class="btn btn-primary">Salvar</button>
                    <a href="@Url.Action("Index", "Produtos")" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-mask-plugin/1.14.16/jquery.mask.min.js"></script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
